{
  "name": "lizi",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:dev": "cross-env DATA_PATH=\"C:\\Users\\g\\Desktop\\DATA\" cross-env NODE_ENV=development vite --config vite.config.js",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build --config vite.config.js",
    "build:electron": "vite build --config vite.config.js --mode production",
    "postbuild": "node scripts/create-preload.js",
    "preview": "vite preview",
    "build:win": "electron-builder --windows nsis --publish never"
  },
  "build": {
    "appId": "com.yourcompany.lizi",
    "productName": "Lizi",
    "directories": {
      "output": "dist-windows"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-electron/preload.js",
        "to": "preload.js"
      }
    ],
    "asar": {
      "smartUnpack": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "uninstallDisplayName": "Lizi"
    }
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "element-plus": "^2.9.9",
    "iconv-lite": "^0.6.3",
    "vue": "^3.5.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.2",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^36.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^6.3.1",
    "vite-plugin-electron": "^0.29.0"
  }
}
